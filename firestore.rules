rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- utilidades ----------
    function autenticado() { return request.auth != null; }
    function esYo(uid) { return autenticado() && request.auth.uid == uid; }
    function rolActual() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // vínculo con id determinístico: <elderUid>_<cuidadorUid>
    function esCuidadorDe(elderUid) {
      return autenticado() &&
        exists(/databases/$(database)/documents/vinculos/$(elderUid + '_' + request.auth.uid));
    }
    function puedeVer(elderUid) { return esYo(elderUid) || esCuidadorDe(elderUid); }

    // ---------- perfiles ----------
    match /users/{uid} {
      // el propio usuario, su cuidador, o el adulto mayor que lo tiene como cuidador
      allow read: if esYo(uid) || esCuidadorDe(uid) ||
        (autenticado() && exists(/databases/$(database)/documents/vinculos/$(request.auth.uid + '_' + uid)));
      allow create: if esYo(uid) && request.resource.data.role in ['elder', 'caregiver'];
      allow update: if esYo(uid) && request.resource.data.role == resource.data.role; // el rol no cambia
      allow delete: if false;
    }

    // ---------- tokens de avisos push (teléfonos de cuidadores) ----------
    // id = token del teléfono. Cada usuario solo escribe o borra los suyos; nadie los lee desde
    // la app: la función que envía los avisos los lee con permisos de administrador.
    // Se permite reasignar un token existente: el token es del teléfono, no de la cuenta.
    match /tokensPush/{token} {
      allow read: if false;
      allow create, update: if autenticado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'plataforma', 'actualizadoEn']);
      allow delete: if autenticado() && resource.data.uid == request.auth.uid;
    }

    // ---------- signos vitales ----------
    match /vitalReadings/{id} {
      allow read: if puedeVer(resource.data.elderUid);
      allow create: if esYo(request.resource.data.elderUid)    // solo el adulto mayor registra
        && (!('observaciones' in request.resource.data)
            || (request.resource.data.observaciones is string
                && request.resource.data.observaciones.size() <= 500));
      allow update, delete: if false;                          // historial inmutable
    }

    // ---------- tareas ----------
    match /tasks/{id} {
      allow read: if puedeVer(resource.data.elderUid);
      allow create: if puedeVer(request.resource.data.elderUid);

      // adulto mayor: control sobre lo suyo, salvo quitar una tarea completada (historial)
      allow update: if esYo(resource.data.elderUid)
        && request.resource.data.elderUid == resource.data.elderUid
        && !(resource.data.status == 'done' && request.resource.data.get('eliminada', false) == true);
      // cuidador: solo tareas pendientes y sin tocar el estado (protege la adherencia)
      allow update: if esCuidadorDe(resource.data.elderUid)
        && resource.data.status == 'pending'
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['status', 'completedAt', 'elderUid']);

      // quitar es soft delete (campo eliminada): nadie borra documentos de tareas
      allow delete: if false;
    }

    // ---------- perfil del adulto mayor (lo configura su cuidador) ----------
    // id del documento = elderUid. Margen de aviso, metas de signos vitales y contacto de emergencia.
    match /perfilesAdulto/{elderUid} {
      allow read: if puedeVer(elderUid);
      allow create, update: if esCuidadorDe(elderUid)
        && request.resource.data.keys().hasOnly(
             ['margenAvisoMin', 'metas', 'contactoEmergencia', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.margenAvisoMin is int
        && request.resource.data.margenAvisoMin >= 5 && request.resource.data.margenAvisoMin <= 120
        && request.resource.data.metas is map
        && (request.resource.data.contactoEmergencia == null
            || (request.resource.data.contactoEmergencia is map
                && request.resource.data.contactoEmergencia.telefono is string
                && request.resource.data.contactoEmergencia.telefono.matches('^[+]?[0-9]{8,15}$')))
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if false;
    }

    // ---------- botón de emergencia (SOS) ----------
    // Cada uso queda registrado: lo crea el adulto mayor; lo leen él y su cuidador; nadie lo cambia.
    match /sosEvents/{id} {
      allow read: if puedeVer(resource.data.elderUid);
      allow create: if esYo(request.resource.data.elderUid)
        && request.resource.data.keys().hasOnly(['elderUid', 'telefono', 'nombreContacto', 'esContacto', 'creadoEn'])
        && request.resource.data.telefono is string
        && request.resource.data.esContacto is bool
        && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    // ---------- vinculación ----------
    // el id del documento es el código de 6 dígitos
    match /codigosVinculo/{codigo} {
      allow create: if esYo(request.resource.data.elderUid) && rolActual() == 'elder'
        && request.resource.data.expiraEn > request.time;
      allow get: if autenticado();     // el cuidador lo consulta por código exacto
      allow list, update: if false;    // no se pueden listar ni reutilizar
      // lo borra el adulto mayor, o el cuidador en el mismo batch en que crea el vínculo
      allow delete: if esYo(resource.data.elderUid) || (autenticado() &&
        existsAfter(/databases/$(database)/documents/vinculos/$(resource.data.elderUid + '_' + request.auth.uid)));
    }

    match /vinculos/{vinculoId} {
      // resource == null: permite consultar si el vínculo existe (no expone datos)
      allow read: if resource == null
        || esYo(resource.data.elderUid) || esYo(resource.data.cuidadorUid);
      allow create: if esYo(request.resource.data.cuidadorUid) && rolActual() == 'caregiver'
        && vinculoId == request.resource.data.elderUid + '_' + request.auth.uid
        && get(/databases/$(database)/documents/codigosVinculo/$(request.resource.data.codigo)).data.elderUid
             == request.resource.data.elderUid
        && get(/databases/$(database)/documents/codigosVinculo/$(request.resource.data.codigo)).data.expiraEn
             > request.time;
      allow update: if false;
      allow delete: if esYo(resource.data.elderUid) || esYo(resource.data.cuidadorUid); // cualquiera puede desvincular
    }
  }
}
