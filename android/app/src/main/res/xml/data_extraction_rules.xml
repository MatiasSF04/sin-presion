<?xml version="1.0" encoding="utf-8"?>
<!--
  SIN-PRESIÓN guarda datos de salud: no se respaldan en la nube ni se copian
  al pasar a un teléfono nuevo. Al reinstalar, la app parte siempre limpia.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
